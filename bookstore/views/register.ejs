<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head') %>
</head>
<body>
<%- include('partials/flash') %>
<%- include('partials/header') %>

<div class="auth-wrap">
  <div class="auth-card">
    <div class="icon-crest">✦</div>
    <h1>Join Inkwell</h1>
    <p class="sub">Create your free account and start collecting.</p>

    <form action="/register" method="POST" novalidate>
      <div class="form-group">
        <label for="full_name">Full name</label>
        <input type="text" id="full_name" name="full_name" placeholder="Jane Reader" required autofocus>
      </div>
      <div class="form-group">
        <label for="email">Email address</label>
        <input type="email" id="email" name="email" placeholder="you@example.com" required>
      </div>
      <div class="form-row-2">
        <div class="form-group">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" placeholder="Min. 6 characters" minlength="6" required>
        </div>
        <div class="form-group">
          <label for="confirm_password">Confirm password</label>
          <input type="password" id="confirm_password" name="confirm_password" placeholder="Repeat password" minlength="6" required>
        </div>
      </div>
      <div class="form-group">
        <label for="address">Shipping address <span style="color:var(--text-muted); font-weight:400;">(optional)</span></label>
        <input type="text" id="address" name="address" placeholder="Street, City, State">
      </div>
      <button type="submit" class="btn btn-primary btn-block">Create Account</button>
    </form>

    <div class="auth-footer-link">
      Already have an account? <a href="/login">Log in</a>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
<script src="/js/main.js"></script>
<script src="/js/cart.js"></script>
</body>
</html>
