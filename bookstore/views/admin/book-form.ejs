<!DOCTYPE html>
<html lang="en">
<head>
<%- include('../partials/head') %>
<style>
  .author-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--gradient-primary);
    color: #ffffff;
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    font-size: 0.88rem;
    font-weight: 500;
    box-shadow: 0 2px 8px rgba(99,102,241,0.25);
  }
  .author-chip button {
    background: none;
    border: none;
    color: rgba(255,255,255,0.8);
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
    padding: 0 2px;
    margin-left: 2px;
    transition: color 0.15s;
  }
  .author-chip button:hover {
    color: #fca5a5;
  }
  .author-search-item {
    padding: 10px 14px;
    cursor: pointer;
    border-bottom: 1px solid var(--border-soft);
    transition: background 0.15s ease, color 0.15s ease;
    font-size: 0.9rem;
    color: var(--text-primary);
  }
  .author-search-item:last-child {
    border-bottom: none;
  }
  .author-search-item:hover {
    background: var(--navy-700);
    color: var(--cyan-300);
  }
</style>
</head>
<body>
<%- include('../partials/flash') %>
<%- include('../partials/header') %>

<%
  const bookAuthorIds = book ? book.authors.map(a => a.id) : [];
  const bookGenreIds = book ? book.genres.map(g => g.id) : [];
%>

<div class="container admin-wrap">
  <div class="dashboard-header">
    <div>
      <h1><%= book ? 'Edit Book' : 'Add New Book' %></h1>
      <p><%= book ? 'Update the details for ' + book.title : 'Add a new title to the Inkwell catalogue.' %></p>
    </div>
  </div>

  <%- include('../partials/admin-tabs') %>

  <div class="admin-form-card">
    <form action="<%= book ? `/admin/books/${book.id}/edit` : '/admin/books/new' %>" method="POST">
      <div class="form-row-2">
        <div class="form-group">
          <label>Title</label>
          <input type="text" name="title" value="<%= book ? book.title : '' %>" required>
        </div>
        <div class="form-group">
          <label>ISBN</label>
          <input type="text" name="isbn" value="<%= book ? (book.isbn || '') : '' %>">
        </div>
      </div>

      <div class="form-group">
        <label>Description</label>
        <textarea name="description" rows="4"><%= book ? (book.description || '') : '' %></textarea>
      </div>

      <div class="form-row-2">
        <div class="form-group">
          <label>Price (₹)</label>
          <input type="number" step="0.01" name="price" value="<%= book ? book.price : '' %>" required>
        </div>
        <div class="form-group">
          <label>Cover Image URL</label>
          <input type="text" id="coverImageInput" name="cover_image" value="<%= book ? book.cover_image : '/images/covers/default.svg' %>" placeholder="Paste any image URL or local /images/covers/… path">
          <span style="font-size:0.78rem; color:var(--text-muted);">Paste a direct link to a cover image from anywhere on the web, or use one of the bundled placeholders in <code>/images/covers/</code>.</span>
        </div>
      </div>

      <div class="form-group">
        <label>Cover Preview</label>
        <div style="width:110px; height:165px; border-radius:8px; overflow:hidden; border:1px solid var(--border-soft-2); background:var(--navy-800);">
          <img id="coverPreviewImg" src="<%= book ? book.cover_image : '/images/covers/default.svg' %>" alt="Cover preview" style="width:100%; height:100%; object-fit:cover;" onerror="this.src='/images/covers/default.svg'">
        </div>
      </div>

      <div class="form-row-2">
        <div class="form-group">
          <label>Publisher</label>
          <input type="text" name="publisher" value="<%= book ? (book.publisher || '') : '' %>">
        </div>
        <div class="form-group">
          <label>Publication Year</label>
          <input type="number" name="publication_year" value="<%= book ? (book.publication_year || '') : '' %>">
        </div>
      </div>

      <div class="form-row-2">
        <div class="form-group">
          <label>Pages</label>
          <input type="number" name="pages" value="<%= book ? (book.pages || '') : '' %>">
        </div>
        <div class="form-group">
          <label>Language</label>
          <input type="text" name="language" value="<%= book ? book.language : 'English' %>">
        </div>
      </div>

      <div class="form-row-2">
        <% if (!book) { %>
          <div class="form-group">
            <label>Initial Stock Quantity</label>
            <input type="number" name="stock_quantity" value="0" required>
          </div>
        <% } %>
        <div class="form-group">
          <label>Rating (0–5)</label>
          <input type="number" step="0.1" min="0" max="5" name="rating" value="<%= book ? book.rating : '4.0' %>">
        </div>
      </div>

      <div class="form-group">
        <label class="opt" style="font-weight:600;">
          <input type="checkbox" name="featured" <%= book && book.featured ? 'checked' : '' %>>
          Feature this book on the home page
        </label>
      </div>

      <!-- SEARCHABLE AUTHORS SELECTOR -->
      <div class="form-group">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
          <label style="margin:0;">Authors <span style="font-weight:normal; font-size:0.85rem; color:var(--text-muted);">(Search and select one or more authors)</span></label>
          <button type="button" id="quickAddAuthorBtn" class="btn btn-ghost btn-sm" style="font-size:0.8rem; padding:4px 12px;">+ Quick Add Author</button>
        </div>

        <!-- Inline Quick Add Form -->
        <div id="quickAuthorModal" style="display:none; margin-bottom:14px; padding:16px; background:var(--navy-850); border:1px solid var(--indigo-500); border-radius:var(--radius-sm);">
          <h4 style="margin-top:0; margin-bottom:12px; font-size:0.95rem; color:var(--cyan-300);">Create New Author</h4>
          <div class="form-row-2">
            <div class="form-group" style="margin-bottom:8px;">
              <input type="text" id="quickAuthorName" placeholder="Author Full Name *" style="padding:8px 12px; font-size:0.9rem;">
            </div>
            <div class="form-group" style="margin-bottom:8px;">
              <input type="text" id="quickAuthorBio" placeholder="Short Bio (optional)" style="padding:8px 12px; font-size:0.9rem;">
            </div>
          </div>
          <div style="display:flex; gap:10px; justify-content:flex-end; margin-top:8px;">
            <button type="button" id="saveQuickAuthorBtn" class="btn btn-primary btn-sm">Save & Select</button>
            <button type="button" id="cancelQuickAuthorBtn" class="btn btn-ghost btn-sm">Cancel</button>
          </div>
        </div>

        <!-- Selected Author Chips -->
        <div id="selectedAuthorChips" style="display:flex; flex-wrap:wrap; gap:8px; margin-bottom:10px; min-height:44px; padding:8px; border:1px dashed var(--border-soft-2); border-radius:var(--radius-sm); background:var(--navy-900); align-items:center;">
          <span id="noAuthorPlaceholder" style="color:var(--text-muted); font-size:0.88rem; padding-left:4px;">No authors selected yet. Search below to add.</span>
        </div>

        <!-- Live Author Search Box -->
        <div style="position:relative;">
          <input type="text" id="authorSearchInput" placeholder="🔍 Type author name to search..." autocomplete="off">
          <div id="authorSearchResults" style="display:none; position:absolute; top:calc(100% + 4px); left:0; right:0; max-height:220px; overflow-y:auto; background:var(--navy-800); border:1px solid var(--indigo-500); border-radius:var(--radius-sm); z-index:50; box-shadow:var(--shadow-soft);">
          </div>
        </div>
      </div>

      <!-- GENRES CHECKBOX GRID -->
      <div class="form-group">
        <label>Genres</label>
        <div class="checkbox-grid">
          <% genres.forEach(function(g){ %>
            <label><input type="checkbox" name="genreIds" value="<%= g.id %>" <%= bookGenreIds.includes(g.id) ? 'checked' : '' %>> <%= g.name %></label>
          <% }) %>
        </div>
      </div>

      <div style="display:flex; gap:14px; margin-top:26px;">
        <button type="submit" class="btn btn-primary"><%= book ? 'Save Changes' : 'Add Book' %></button>
        <a href="/admin/books" class="btn btn-ghost">Cancel</a>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>
<script src="/js/main.js"></script>
<script src="/js/cart.js"></script>
<script>
  // Cover Preview Listener
  const coverInput = document.getElementById('coverImageInput');
  const coverPreview = document.getElementById('coverPreviewImg');
  coverInput.addEventListener('input', () => {
    coverPreview.src = coverInput.value.trim() || '/images/covers/default.svg';
  });

  // Searchable Author Selection Logic
  let allAuthorsList = <%- JSON.stringify(authors) %>;
  const initialSelected = <%- JSON.stringify(book ? book.authors : []) %>;
  
  // Map of selected authorId -> authorObj
  const selectedAuthors = new Map();
  initialSelected.forEach(a => selectedAuthors.set(Number(a.id), a));

  const searchInput = document.getElementById('authorSearchInput');
  const resultsDiv = document.getElementById('authorSearchResults');
  const chipsDiv = document.getElementById('selectedAuthorChips');
  const noAuthorPlaceholder = document.getElementById('noAuthorPlaceholder');

  function renderChips() {
    // Clear chips container except placeholder if empty
    chipsDiv.innerHTML = '';
    if (selectedAuthors.size === 0) {
      chipsDiv.appendChild(noAuthorPlaceholder);
      noAuthorPlaceholder.style.display = 'inline';
      return;
    }

    selectedAuthors.forEach((author, id) => {
      const chip = document.createElement('div');
      chip.className = 'author-chip';
      chip.innerHTML = `
        <span>${escapeHtml(author.name)}</span>
        <input type="hidden" name="authorIds" value="${id}">
        <button type="button" title="Remove">&times;</button>
      `;
      chip.querySelector('button').addEventListener('click', () => {
        selectedAuthors.delete(id);
        renderChips();
      });
      chipsDiv.appendChild(chip);
    });
  }

  function escapeHtml(text) {
    const div = document.createElement('div');
    div.innerText = text;
    return div.innerHTML;
  }

  function filterAndShowAuthors(query) {
    const q = query.trim().toLowerCase();
    resultsDiv.innerHTML = '';

    const matching = allAuthorsList.filter(a => {
      const isSelected = selectedAuthors.has(Number(a.id));
      const nameMatches = a.name.toLowerCase().includes(q);
      return !isSelected && nameMatches;
    });

    if (matching.length === 0) {
      if (q.length > 0) {
        resultsDiv.innerHTML = `<div class="author-search-item" style="color:var(--text-muted); cursor:default;">No matching authors found. Click "+ Quick Add Author" above to add "${escapeHtml(query)}".</div>`;
      } else {
        resultsDiv.style.display = 'none';
        return;
      }
    } else {
      matching.forEach(a => {
        const item = document.createElement('div');
        item.className = 'author-search-item';
        item.innerText = a.name;
        item.addEventListener('click', () => {
          selectedAuthors.set(Number(a.id), a);
          renderChips();
          searchInput.value = '';
          resultsDiv.style.display = 'none';
        });
        resultsDiv.appendChild(item);
      });
    }

    resultsDiv.style.display = 'block';
  }

  searchInput.addEventListener('input', (e) => {
    filterAndShowAuthors(e.target.value);
  });

  searchInput.addEventListener('focus', () => {
    filterAndShowAuthors(searchInput.value);
  });

  // Hide dropdown on clicking outside
  document.addEventListener('click', (e) => {
    if (!searchInput.contains(e.target) && !resultsDiv.contains(e.target)) {
      resultsDiv.style.display = 'none';
    }
  });

  // Quick Add Author Logic
  const quickModal = document.getElementById('quickAuthorModal');
  const quickBtn = document.getElementById('quickAddAuthorBtn');
  const cancelQuickBtn = document.getElementById('cancelQuickAuthorBtn');
  const saveQuickBtn = document.getElementById('saveQuickAuthorBtn');
  const quickNameInput = document.getElementById('quickAuthorName');
  const quickBioInput = document.getElementById('quickAuthorBio');

  quickBtn.addEventListener('click', () => {
    quickModal.style.display = quickModal.style.display === 'none' ? 'block' : 'none';
    if (quickModal.style.display === 'block') {
      quickNameInput.value = searchInput.value.trim();
      quickNameInput.focus();
    }
  });

  cancelQuickBtn.addEventListener('click', () => {
    quickModal.style.display = 'none';
    quickNameInput.value = '';
    quickBioInput.value = '';
  });

  saveQuickBtn.addEventListener('click', async () => {
    const name = quickNameInput.value.trim();
    const bio = quickBioInput.value.trim();
    if (!name) {
      alert('Please enter author name.');
      return;
    }

    saveQuickBtn.disabled = true;
    saveQuickBtn.innerText = 'Saving...';

    try {
      const res = await fetch('/admin/authors/api-create', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, bio })
      });
      const data = await res.json();

      if (!res.ok || !data.success) {
        throw new Error(data.error || 'Failed to create author');
      }

      const newAuthor = data.author;
      allAuthorsList.push(newAuthor);
      selectedAuthors.set(Number(newAuthor.id), newAuthor);
      renderChips();

      quickModal.style.display = 'none';
      quickNameInput.value = '';
      quickBioInput.value = '';
      searchInput.value = '';
      resultsDiv.style.display = 'none';
    } catch (err) {
      alert(err.message);
    } finally {
      saveQuickBtn.disabled = false;
      saveQuickBtn.innerText = 'Save & Select';
    }
  });

  // Initial render of chips
  renderChips();
</script>
</body>
</html>
