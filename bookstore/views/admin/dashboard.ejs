<!DOCTYPE html>
<html lang="en">
<head>
<%- include('../partials/head') %>
</head>
<body>
<%- include('../partials/flash') %>
<%- include('../partials/header') %>

<div class="container admin-wrap">
  <div class="dashboard-header">
    <div>
      <h1>Admin Overview</h1>
      <p>Store performance and inventory at a glance.</p>
    </div>
  </div>

  <%- include('../partials/admin-tabs') %>

  <div class="stat-cards">
    <div class="stat-card"><div class="num"><%= stats.totalBooks %></div><div class="label">Total Titles</div></div>
    <div class="stat-card"><div class="num"><%= stats.totalUsers %></div><div class="label">Registered Customers</div></div>
    <div class="stat-card"><div class="num"><%= stats.totalOrders %></div><div class="label">Orders Placed</div></div>
    <div class="stat-card"><div class="num">₹<%= Number(stats.revenue).toFixed(2) %></div><div class="label">Total Revenue</div></div>
  </div>

  <div style="display:grid; grid-template-columns: 1fr 1fr; gap:30px; align-items:flex-start;">
    <div>
      <h2 style="font-size:1.2rem; margin-bottom:16px;">⚠️ Low Stock Alerts</h2>
      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead><tr><th>Book</th><th>Stock Left</th><th></th></tr></thead>
          <tbody>
            <% if (!lowStock.length) { %>
              <tr><td colspan="3" style="color:var(--text-muted);">All titles are well stocked 🎉</td></tr>
            <% } %>
            <% lowStock.forEach(function(b){ %>
              <tr>
                <td><%= b.title %></td>
                <td><span class="stock-num <%= b.stock_quantity === 0 ? 'out' : 'low' %>"><%= b.stock_quantity %></span></td>
                <td><a href="/admin/books/<%= b.id %>/edit" class="btn btn-ghost btn-sm">Manage</a></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <div>
      <h2 style="font-size:1.2rem; margin-bottom:16px;">🧾 Recent Orders</h2>
      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead><tr><th>#</th><th>Customer</th><th>Total</th><th>Status</th></tr></thead>
          <tbody>
            <% recentOrders.forEach(function(o){ %>
              <tr>
                <td>#<%= o.id %></td>
                <td><%= o.full_name %></td>
                <td>₹<%= Number(o.total_amount).toFixed(2) %></td>
                <td><span class="order-status <%= o.status %>"><%= o.status %></span></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
<script src="/js/main.js"></script>
<script src="/js/cart.js"></script>
</body>
</html>
