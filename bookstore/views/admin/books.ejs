<!DOCTYPE html>
<html lang="en">
<head>
<%- include('../partials/head') %>
</head>
<body>
<%- include('../partials/flash') %>
<%- include('../partials/header') %>

<div class="container admin-wrap">
  <div class="dashboard-header">
    <div>
      <h1>Manage Books</h1>
      <p>Add new titles, edit details, and adjust stock levels.</p>
    </div>
    <a href="/admin/books/new" class="btn btn-primary">+ Add New Book</a>
  </div>

  <%- include('../partials/admin-tabs') %>

  <div class="admin-table-wrap">
    <table class="admin-table">
      <thead>
        <tr><th>Title</th><th>Price</th><th>Stock</th><th>Featured</th><th>Restock / Adjust</th><th>Actions</th></tr>
      </thead>
      <tbody>
        <% books.forEach(function(b){ %>
          <% const stockClass = b.stock_quantity === 0 ? 'out' : (b.stock_quantity <= 10 ? 'low' : 'healthy'); %>
          <tr>
            <td><%= b.title %></td>
            <td>₹<%= Number(b.price).toFixed(2) %></td>
            <td><span class="stock-num <%= stockClass %>"><%= b.stock_quantity %></span></td>
            <td><%= b.featured ? '⭐' : '—' %></td>
            <td>
              <form action="/admin/books/<%= b.id %>/stock" method="POST" class="inline-stock-form">
                <input type="number" name="delta" placeholder="±qty" required>
                <select name="reason">
                  <option value="restock">Restock</option>
                  <option value="adjustment">Adjustment</option>
                </select>
                <button type="submit" class="btn btn-ghost btn-sm">Apply</button>
              </form>
            </td>
            <td style="white-space:nowrap;">
              <a href="/admin/books/<%= b.id %>/edit" class="btn btn-outline btn-sm">Edit</a>
              <form action="/admin/books/<%= b.id %>/delete" method="POST" class="inline-form" onsubmit="return confirm('Delete this book permanently?');">
                <button type="submit" class="btn btn-danger btn-sm">Delete</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/footer') %>
<script src="/js/main.js"></script>
<script src="/js/cart.js"></script>
</body>
</html>
