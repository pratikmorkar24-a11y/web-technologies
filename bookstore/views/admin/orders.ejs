<!DOCTYPE html>
<html lang="en">
<head>
<%- include('../partials/head') %>
</head>
<body>
<%- include('../partials/flash') %>
<%- include('../partials/header') %>

<div class="container admin-wrap">
  <div class="dashboard-header">
    <div>
      <h1>All Orders</h1>
      <p>Every order placed across the store.</p>
    </div>
  </div>

  <%- include('../partials/admin-tabs') %>

  <div class="admin-table-wrap">
    <table class="admin-table">
      <thead>
        <tr><th>Order #</th><th>Customer</th><th>Email</th><th>Date</th><th>Total</th><th>Status</th></tr>
      </thead>
      <tbody>
        <% if (!orders.length) { %>
          <tr><td colspan="6" style="color:var(--text-muted);">No orders have been placed yet.</td></tr>
        <% } %>
        <% orders.forEach(function(o){ %>
          <tr>
            <td>#<%= o.id %></td>
            <td><%= o.full_name %></td>
            <td><%= o.email %></td>
            <td><%= new Date(o.order_date).toLocaleDateString('en-IN') %></td>
            <td>₹<%= Number(o.total_amount).toFixed(2) %></td>
            <td><span class="order-status <%= o.status %>"><%= o.status %></span></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/footer') %>
<script src="/js/main.js"></script>
<script src="/js/cart.js"></script>
</body>
</html>
